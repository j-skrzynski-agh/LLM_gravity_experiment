 "response": "An implementation of the `Loyalty` class satisfying all requirements is provided below:\n\n```python\nfrom datetime import date, timedelta\n\n\nclass Loyalty:\n    def __init__(self) -> None:\n        self._purchases: dict[str, list[tuple[date, int]]] = {}\n        self._redemptions: dict[str, list[tuple[date, int]]] = {}\n\n    def purchase(self, customer: str, amount: float, day: date) -> int:\n        \"\"\"Record a purchase; returns the number of points earned.\"\"\"\n        points = max(0, int(amount // 10))\n        self._purchases.setdefault(customer, []).append((day, points))\n        return points\n\n    def balance(self, customer: str, day: date) -> int:\n        \"\"\"Points the customer can spend on the given day.\"\"\"\n        earned = sum(\n            pts\n            for p_day, pts in self._purchases.get(customer, [])\n            if day >= p_day + timedelta(days=14)\n        )\n        redeemed = sum(\n            pts\n            for r_day, pts in self._redemptions.get(customer, [])\n            if r_day <= day\n        )\n        return earned - redeemed\n\n    def redeem(self, customer: str, points: int, day: date) -> None:\n        if points <= 0 or points % 100 != 0:\n            raise ValueError(\"Points can be redeemed only in positive multiples of 100.\")\n\n        if points > self.balance(customer, day):\n            raise ValueError(\"Redeeming more points than the available balance.\")\n\n        # Tentatively apply redemption and verify balance consistency\n        customer_redemptions = self._redemptions.setdefault(customer, [])\n        customer_redemptions.append((day, points))\n\n        # Ensure future redemptions do not cause the balance to become negative\n        future_dates = {r_day for r_day, _ in customer_redemptions if r_day >= day}\n        if any(self.balance(customer, d) < 0 for d in future_dates):\n            customer_redemptions.pop()\n            raise ValueError(\"Redeeming exceeds available balance.\")\n```",
